{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run tach:*)",
      "Bash(uv run deptry:*)",
      "Bash(uv run vulture:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(claude -p:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q \"\\\"file_path\\\" *: *\\\"[^\\\"]*uv\\.lock\\\"\" && { echo \"uv.lock is large; grep it instead of reading it whole\" >&2; exit 2; }; exit 0"
          }
        ]
      }
    ]
  }
}
